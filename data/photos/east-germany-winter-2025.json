 },
 "berlin-museum-island/20251213_115823.jpg": {
  "w": 1500,
  "h": 2000,
  "source": "08 - Берлин - Музейный остров/29_20251213_115823.jpg",
  "caption": "Берлинский золотой шлем (Berlin Gold Hat) — уникальный ритуальный предмет бронзового века, изготовленный из тончайшего листового золота, украшенного сложной системой тиснёных символов, связанных с движением Солнца, Луны и планет. Эти орнаменты представляют собой зашифрованную календарную систему, позволяющую согласовывать солнечный и лунный циклы, включая 19-летний метонов цикл, что говорит о высоком уровне астрономических знаний. Шлем, вероятно, носил не бог, а человек — жре… See more"
 },
